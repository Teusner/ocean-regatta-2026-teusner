<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="practice_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Simulation Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>

    <plugin filename="gz-sim-buoyancy-system" name="gz::sim::systems::Buoyancy">
      <uniform_fluid_density>1000.0</uniform_fluid_density>
    </plugin>

    <!-- Lighting & Water -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 50 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.2 -1.0</direction>
    </light>

    <model name="water_plane">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>250 250</size></plane></geometry>
          <material>
            <ambient>0.04 0.18 0.32 0.85</ambient>
            <diffuse>0.08 0.28 0.48 0.85</diffuse>
            <specular>0.7 0.8 0.9 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- BlueBoat USV Model -->
    <include>
      <uri>model://blueboat</uri>
      <name>blueboat</name>
      <pose>0 0 0.05 0 0 0</pose>
    </include>

    <!-- Gate 1 -->
    <model name="gate_port_1">
      <static>true</static>
      <pose>12.0 2.5 0.4 0 0 0</pose>
      <link name="link">
        <visual name="body"><geometry><cylinder><radius>0.25</radius><length>1.0</length></cylinder></geometry><material><ambient>0.8 0.05 0.05 1</ambient><diffuse>0.95 0.1 0.1 1</diffuse></material></visual>
        <visual name="topmark"><pose>0 0 0.65 0 0 0</pose><geometry><cylinder><radius>0.15</radius><length>0.3</length></cylinder></geometry><material><ambient>0.7 0.05 0.05 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse></material></visual>
      </link>
    </model>

    <model name="gate_starboard_1">
      <static>true</static>
      <pose>12.0 -2.5 0.4 0 0 0</pose>
      <link name="link">
        <visual name="body"><geometry><cone><radius>0.3</radius><length>1.0</length></cone></geometry><material><ambient>0.05 0.75 0.1 1</ambient><diffuse>0.1 0.9 0.15 1</diffuse></material></visual>
        <visual name="topmark"><pose>0 0 0.65 0 0 0</pose><geometry><cone><radius>0.18</radius><length>0.35</length></cone></geometry><material><ambient>0.05 0.7 0.1 1</ambient><diffuse>0.1 0.85 0.15 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Gate 2 -->
    <model name="gate_port_2">
      <static>true</static>
      <pose>24.0 2.6 0.4 0 0 0</pose>
      <link name="link">
        <visual name="body"><geometry><cylinder><radius>0.25</radius><length>1.0</length></cylinder></geometry><material><ambient>0.8 0.05 0.05 1</ambient><diffuse>0.95 0.1 0.1 1</diffuse></material></visual>
      </link>
    </model>

    <model name="gate_starboard_2">
      <static>true</static>
      <pose>24.0 -2.4 0.4 0 0 0</pose>
      <link name="link">
        <visual name="body"><geometry><cone><radius>0.3</radius><length>1.0</length></cone></geometry><material><ambient>0.05 0.75 0.1 1</ambient><diffuse>0.1 0.9 0.15 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Gate 3 -->
    <model name="gate_port_3">
      <static>true</static>
      <pose>36.0 2.5 0.4 0 0 0</pose>
      <link name="link">
        <visual name="body"><geometry><cylinder><radius>0.25</radius><length>1.0</length></cylinder></geometry><material><ambient>0.8 0.05 0.05 1</ambient><diffuse>0.95 0.1 0.1 1</diffuse></material></visual>
      </link>
    </model>

    <model name="gate_starboard_3">
      <static>true</static>
      <pose>36.0 -2.5 0.4 0 0 0</pose>
      <link name="link">
        <visual name="body"><geometry><cone><radius>0.3</radius><length>1.0</length></cone></geometry><material><ambient>0.05 0.75 0.1 1</ambient><diffuse>0.1 0.9 0.15 1</diffuse></material></visual>
      </link>
    </model>

    <!-- North Cardinal Buoy -->
    <model name="cardinal_north">
      <static>true</static>
      <pose>46.0 0.0 0.6 0 0 0</pose>
      <link name="link">
        <visual name="body"><geometry><cylinder><radius>0.35</radius><length>1.5</length></cylinder></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
        <visual name="cone_lower"><pose>0 0 1.0 0 0 0</pose><geometry><cone><radius>0.18</radius><length>0.25</length></cone></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
        <visual name="cone_upper"><pose>0 0 1.3 0 0 0</pose><geometry><cone><radius>0.18</radius><length>0.25</length></cone></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Pier / Wall -->
    <model name="pier_wall">
      <static>true</static>
      <pose>65.0 -3.5 1.0 0 0 0</pose>
      <link name="pier_link">
        <collision name="pier_collision"><geometry><box><size>55.0 4.0 2.5</size></box></geometry></collision>
        <visual name="pier_visual"><geometry><box><size>55.0 4.0 2.5</size></box></geometry><material><ambient>0.3 0.32 0.35 1</ambient><diffuse>0.45 0.48 0.5 1</diffuse></material></visual>
      </link>
    </model>

  </world>
</sdf>
